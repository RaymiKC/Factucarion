# ============================================================
# FacturaPro API - environment
# Copy to .env and adjust. Never commit the real .env.
# ============================================================

# Which database backend the API talks to: postgres | sqlserver
DB_PROVIDER=postgres

# HTTP port for the API (the React/Angular apps call this)
API_PORT=3001

# Comma separated list of allowed browser origins ("*" for local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:4200,*

# Public base URL used to build absolute file URLs (company logos)
PUBLIC_URL=http://localhost:3001

# Folder where uploaded files (logos) are stored
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
# HS256 signing secret - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Set to true to return OTP tokens in the API response instead of emailing them
OTP_DEBUG=true

# ------------------------------------------------------------
# PostgreSQL (used when DB_PROVIDER=postgres)
# ------------------------------------------------------------
PG_CONNECTION_STRING=postgres://postgres:postgres@127.0.0.1:5432/facturpro
# Alternative to the connection string - used only if PG_CONNECTION_STRING is empty
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DATABASE=facturpro
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_SSL=false

# ------------------------------------------------------------
# SQL Server (used when DB_PROVIDER=sqlserver)
# ------------------------------------------------------------
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=FacturaPro;User Id=sa;Password=YourPassword;TrustServerCertificate=true
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=FacturaPro
# MSSQL_USER=sa
# MSSQL_PASSWORD=YourPassword
# Windows authentication (no SQL login required):
# MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
# MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
